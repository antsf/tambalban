<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The "No-Line" Rule Base Styles -->
    <style name="Guardian.List" parent="">
        <!-- Remove dividers from all lists -->
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
    </style>

    <!-- Component: Primary Action Button (Orchid Pill) -->
    <style name="Guardian.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/selector_button_primary</item>
        <item name="android:textColor">@color/on_primary_container</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Guardian.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.Guardian.LabelMedium</item>
    </style>

    <!-- Component: Secondary Button -->
    <style name="Guardian.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="backgroundTint">@color/surface_container_lowest</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Guardian.Pill</item>
    </style>

    <!-- Shape Definitions -->
    <style name="ShapeAppearance.Guardian.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>

    <!-- Emergency Chips Style (Safety Green) -->
    <style name="Guardian.Chip.Emergency" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/tertiary_container</item>
        <item name="android:textColor">@color/on_tertiary_container</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Guardian.Pill</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Refreshed Login Styles -->
    <style name="Login.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">#FFFFFF</item>
    </style>

    <style name="Login.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_pill</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_pill</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_pill</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_pill</item>
        <item name="boxBackgroundColor">@color/login_field_bg</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">@color/login_text_secondary</item>
        <item name="android:textColorHint">@color/login_text_secondary</item>
        <item name="startIconTint">@color/login_text_secondary</item>
        <item name="endIconTint">@color/login_text_secondary</item>
    </style>

    <style name="Login.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="backgroundTint">@color/colorPrimaryLogin</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Login.Button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ShapeAppearance.Login.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_pill</item>
    </style>

    <style name="Widget.Tambal.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxBackgroundColor">#F5F5F5</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxStrokeColor">@color/divider</item>
        <item name="hintTextColor">#757575</item>
        <item name="android:textColorHint">#757575</item>
        <item name="startIconTint">#757575</item>
        <item name="endIconTint">#757575</item>
    </style>

    <!-- Home Screen Refresh Styles -->
    <style name="Home.SearchCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_pill</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface_container_lowest</item>
    </style>

    <style name="Home.BottomSheet" parent="">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Home.BottomSheet</item>
        <item name="backgroundTint">@color/card</item>
    </style>

    <style name="ShapeAppearance.Home.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_pill</item>
        <item name="cornerSizeTopRight">@dimen/radius_pill</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
