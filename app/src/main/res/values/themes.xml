<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TambalBan" parent="Theme.Material3.Light.NoActionBar">
        <!-- Generic Mapping for Guardian Brand -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        
        <!-- Surface Architecture (The No-Line Rule) -->
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_container_low</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        
        <!-- Typography Mapping -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Guardian.DisplayLarge</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Guardian.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Guardian.HeadlineLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Guardian.TitleLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Guardian.BodyLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Guardian.LabelMedium</item>

        <!-- Components Geometry -->
        <item name="cornerRadius">@dimen/radius_xl</item>
        
        <!-- Status Bar & Edge-to-Edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>

    <!-- Bottom Sheet Base Contract -->
    <style name="Theme.Guardian.BottomSheet" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Guardian.BottomSheet</item>
    </style>

    <style name="Widget.Guardian.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Guardian.BottomSheet</item>
        <item name="backgroundTint">@color/surface_container_lowest</item>
    </style>

    <style name="ShapeAppearance.Guardian.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_lg</item>
        <item name="cornerSizeTopRight">@dimen/radius_lg</item>
    </style>
</resources>
