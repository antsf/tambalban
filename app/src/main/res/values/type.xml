<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Display Styles (Plus Jakarta Sans) -->
    <style name="TextAppearance.Guardian.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">57sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Guardian.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/plus_jakarta_sans_bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.Guardian.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">32sp</item>
    </style>

    <!-- Title & Body Styles (Inter) -->
    <style name="TextAppearance.Guardian.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.Guardian.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Guardian.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
</resources>
