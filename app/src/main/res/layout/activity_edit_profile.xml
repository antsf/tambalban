<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/surface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnSave"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/TextAppearance.Guardian.HeadlineLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Profil"
                android:textColor="@color/on_surface" />

            <TextView
                style="@style/TextAppearance.Guardian.BodyLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Perbarui informasi Anda di bawah ini"
                android:textColor="@color/on_surface_variant" />

            <com.tambal_ban.ui.components.AvatarView
                android:id="@+id/avatarView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                app:avatarSize="100dp"
                app:showEditButton="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Nama Lengkap"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.tambal_ban.ui.components.TambalTextField
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:fieldHint="Masukkan nama lengkap"
                app:fieldIcon="@drawable/ic_person" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Alamat Email"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.tambal_ban.ui.components.TambalTextField
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:fieldHint="email@example.com"
                app:fieldIcon="@drawable/ic_mail"
                app:fieldVariant="email" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Nomor Telepon"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.tambal_ban.ui.components.TambalTextField
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:fieldHint="08123456789"
                app:fieldIcon="@drawable/ic_phone"
                android:inputType="phone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.tambal_ban.ui.components.TambalButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:btnText="Simpan"
        app:btnVariant="primary"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
