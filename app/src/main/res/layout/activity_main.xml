<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.main.MainActivity">

    <!-- T007: Map View Base Layer -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- T015: Search Overlay -->
    <include
        android:id="@+id/searchOverlay"
        layout="@layout/view_search_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp" />

    <!-- T012: Interactive Bottom Sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheet"
        style="@style/Home.BottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="12dp"
        app:strokeWidth="0dp"
        app:behavior_draggable="true"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:behavior_fitToContents="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sticky Header Part -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@color/white">

                <!-- Drag Handle -->
                <View
                    android:layout_width="32dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@color/divider" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvSheetTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tambal Ban Terdekat"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Lihat Semua"
                        android:textSize="14sp"
                        android:textColor="@color/primary"/>

                </RelativeLayout>
            </LinearLayout>

            <!-- Scrolling Content -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <!-- Skeleton Loading -->
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:paddingHorizontal="16dp"
                    app:shimmer_auto_start="true"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <include layout="@layout/item_workshop_skeleton" />
                        <include layout="@layout/item_workshop_skeleton" />
                        <include layout="@layout/item_workshop_skeleton" />
                        <include layout="@layout/item_workshop_skeleton" />
                        <include layout="@layout/item_workshop_skeleton" />
                    </LinearLayout>

                </com.facebook.shimmer.ShimmerFrameLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWorkshopsNearby"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="24dp"
                    android:nestedScrollingEnabled="true"
                    tools:listitem="@layout/item_workshop_nearby" />

                <!-- Empty State -->
                <include
                    android:id="@+id/viewEmptyState"
                    layout="@layout/view_empty_state"
                    android:visibility="gone" />

                <!-- Error State -->
                <include
                    android:id="@+id/viewErrorState"
                    layout="@layout/view_error_state"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- My Location FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="My Location"
        android:src="@drawable/ic_my_location"
        app:layout_anchor="@id/bottomSheet"
        app:layout_anchorGravity="top|end"
        android:translationY="-40dp"
        app:backgroundTint="@color/white"
        app:tint="@color/primary"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
        app:borderWidth="0dp"
        app:elevation="6dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Global Loading Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
