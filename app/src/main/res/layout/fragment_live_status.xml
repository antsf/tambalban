<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/glass_overlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/on_surface_variant"
            android:alpha="0.2" />

        <TextView
            android:id="@+id/tvStatusUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textColor="@color/on_surface"
            tools:text="Help is 5 mins away" />

        <TextView
            android:id="@+id/tvDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/on_surface_variant"
            tools:text="Mobile repair unit #402 is en route to your location." />

        <!-- Track Progress Button -->
        <com.tambal_ban.core.ui.TambalButton
            android:id="@+id/btnTrackProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:btnText="@string/action_track_progress"
            app:btnVariant="primary" />

    </LinearLayout>

</FrameLayout>
