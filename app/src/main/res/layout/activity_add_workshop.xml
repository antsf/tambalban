<?xml version="1.0" encoding="utf-8" ?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".workshop.ui.AddWorkshopActivity"
>

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
    >

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/on_surface"
            app:title="Tambah Tambal Ban"
            app:titleCentered="true"
            app:titleTextColor="@color/on_surface"
            app:titleTextAppearance="@style/TextAppearance.Guardian.TitleMedium"
        />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
    >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
        >

            <!-- Name -->
            <TextView
                android:id="@+id/tvNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_name"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
            />

            <com.tambal_ban.core.ui.TambalTextField
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:fieldHint="@string/label_name"
                app:fieldIcon="@drawable/ic_person"
            />

            <!-- Address -->
            <TextView
                android:id="@+id/tvAddressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_address"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
            />

            <com.tambal_ban.core.ui.TambalTextField
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:fieldHint="@string/label_address"
                app:fieldIcon="@drawable/ic_marker_pin"
            />

            <!-- City -->
            <TextView
                android:id="@+id/tvCityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_city"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
            />

            <com.tambal_ban.core.ui.TambalTextField
                android:id="@+id/etCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:fieldHint="@string/label_city"
            />

            <!-- Phone -->
            <TextView
                android:id="@+id/tvPhoneLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_phone"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
            />

            <com.tambal_ban.core.ui.TambalTextField
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:fieldHint="@string/label_phone"
                app:fieldIcon="@drawable/ic_phone"
                app:fieldVariant="phone"
            />

            <!-- Province -->
            <TextView
                android:id="@+id/tvProvinceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_province"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
            />

            <com.tambal_ban.core.ui.TambalTextField
                android:id="@+id/etProvince"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:fieldHint="@string/label_province"
            />

            <!-- Opening Hours -->
            <TextView
                android:id="@+id/tvOpeningHoursLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/label_opening_hours"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
            />

            <com.tambal_ban.core.ui.TambalTextField
                android:id="@+id/etOpeningHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:fieldHint="@string/hint_opening_hours"
                app:fieldIcon="@drawable/ic_schedule"
            />

            <!-- Latitude -->
            <TextView
                android:id="@+id/tvLatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hint_latitude"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
            />

            <com.tambal_ban.core.ui.TambalTextField
                android:id="@+id/etLat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="numberSigned|numberDecimal"
                app:fieldHint="@string/hint_latitude"
            />

            <!-- Longitude -->
            <TextView
                android:id="@+id/tvLonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hint_longitude"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
            />

            <com.tambal_ban.core.ui.TambalTextField
                android:id="@+id/etLon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:inputType="numberSigned|numberDecimal"
                app:fieldHint="@string/hint_longitude"
            />

            <!-- Current Location Button -->
            <com.tambal_ban.core.ui.TambalButton
                android:id="@+id/btnCurrentLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:btnText="Lokasi Saat Ini"
                app:btnVariant="outlined"
                app:btnIcon="@drawable/ic_my_location"
            />

            <!-- Photo Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_photo_optional"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
            />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAddPhoto"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant_ghost"
                app:strokeWidth="1dp"
            >

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                >

                    <LinearLayout
                        android:id="@+id/placeholderPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                    >

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/primary"
                        />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/btn_add_photo"
                            android:textColor="@color/primary"
                        />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivPhotoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                    />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Submit Button -->
            <com.tambal_ban.core.ui.TambalButton
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                app:btnText="@string/btn_submit"
            />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
